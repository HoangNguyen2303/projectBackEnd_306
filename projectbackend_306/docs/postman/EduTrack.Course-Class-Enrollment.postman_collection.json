{
  "info": {
    "_postman_id": "2f6f4f72-7929-4d3d-a2dc-5bd47f9c7d6e",
    "name": "EduTrack - Department, Course, Class & Enrollment",
    "description": "Meeting 4 collection for Vũ Thế Phương's module. Run Admin Login first. Set teacherId and studentId to existing records before creating a class or enrollment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('adminToken', pm.response.json().data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@edutrack.local\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List Departments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/departments?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "departments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Create Department",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Department created', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('departmentId', pm.response.json().data.id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"IT\",\n  \"name\": \"Information Technology\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/departments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "departments"]
            }
          }
        },
        {
          "name": "Get Department",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "departments", "{{departmentId}}"]
            }
          }
        },
        {
          "name": "Update Department",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"IT\",\n  \"name\": \"School of Information Technology\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "departments", "{{departmentId}}"]
            }
          }
        },
        {
          "name": "Delete Unused Department",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/departments/{{unusedDepartmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "departments", "{{unusedDepartmentId}}"]
            },
            "description": "Set unusedDepartmentId to a department that has no students, teachers, or courses. Deleting a referenced department returns 409."
          }
        }
      ]
    },
    {
