{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=EduTrackDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "EduTrack",
    "Audience": "EduTrackClients",
    "ExpiryMinutes": 120,
    "_comment": "Put the signing Key in user-secrets, NOT here. Run: dotnet user-secrets set \"Jwt:Key\" \"<long-random-secret>\"",
    "key": "some key"

  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
